generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identity & teams ----------

model User {
  id          String       @id @default(cuid())
  tgId        BigInt       @unique @map("tg_id")
  username    String?
  firstName   String?      @map("first_name")
  lastName    String?      @map("last_name")
  photoUrl    String?      @map("photo_url")
  languageCode String?     @map("language_code")
  createdAt   DateTime     @default(now()) @map("created_at")
  memberships Membership[]

  @@map("users")
}

/**
 * Telegram Login payload hashes already consumed once. The hash covers the whole
 * signed payload (including auth_date), so replaying an intercepted login within
 * the freshness window hits the primary key and is rejected. Rows older than the
 * window are dead weight and are pruned opportunistically on login.
 */
model LoginNonce {
  hash      String   @id
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("login_nonces")
}

model Workspace {
  id        String       @id @default(cuid())
  name      String
  /** Effective plan; kept in sync with the active subscription. */
  plan      Plan         @default(FREE)
  /** White-label identity on public client reports (Agency feature); null = TGPulse branding. */
  brandName String?      @map("brand_name")
  /** Optional http(s) link behind the brand name on the report bar. */
  brandUrl  String?      @map("brand_url")
  createdAt DateTime     @default(now()) @map("created_at")
  members   Membership[]
  channels  Channel[]
  subscriptions Subscription[]
  payments      PaymentEvent[]
  invites       WorkspaceInvite[]

  @@map("workspaces")
}

enum Plan {
  FREE
  PRO
  AGENCY
}

/** Current paid access of a workspace. One active row per workspace. */
model Subscription {
  id             String             @id @default(cuid())
  workspaceId    String             @map("workspace_id")
  plan           Plan
  status         SubscriptionStatus @default(ACTIVE)
  provider       PaymentProvider
  /** Telegram charge id of the recurring subscription, when the provider supports it. */
  providerRef    String?            @map("provider_ref")
  /** Access is granted while now() < currentPeriodEnd. */
  currentPeriodEnd DateTime         @map("current_period_end")
  cancelAtPeriodEnd Boolean         @default(false) @map("cancel_at_period_end")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED // still valid until currentPeriodEnd
  EXPIRED
}

enum PaymentProvider {
  TELEGRAM_STARS
  LEMON_SQUEEZY
}

/** Immutable ledger of successful payments; provider id keeps it idempotent. */
model PaymentEvent {
  id                String          @id @default(cuid())
  workspaceId       String          @map("workspace_id")
  provider          PaymentProvider
  providerPaymentId String          @unique @map("provider_payment_id")
  plan              Plan
  /** Minor units for fiat, whole Stars for XTR. */
  amount            Int
  currency          String
  periodDays        Int             @map("period_days")
  payerTgId         BigInt?         @map("payer_tg_id")
  payload           Json?
  createdAt         DateTime        @default(now()) @map("created_at")
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("payment_events")
}

model Membership {
  userId      String        @map("user_id")
  workspaceId String        @map("workspace_id")
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now()) @map("created_at")
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
  @@map("memberships")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  VIEWER
}

/** One-time invite link into a workspace; consumed on accept. */
model WorkspaceInvite {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  token       String        @unique
  role        WorkspaceRole @default(VIEWER)
  createdById String        @map("created_by_id")
  expiresAt   DateTime      @map("expires_at")
  acceptedAt  DateTime?     @map("accepted_at")
  acceptedById String?      @map("accepted_by_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("workspace_invites")
}

/** Read-only public report link for clients; no session required. */
model ShareLink {
  id         String    @id @default(cuid())
  channelId  String    @map("channel_id")
  token      String    @unique
  label      String?
  /** Days of history the recipient may see. */
  windowDays Int       @default(30) @map("window_days")
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdById String   @map("created_by_id")
  viewCount  Int       @default(0) @map("view_count")
  createdAt  DateTime  @default(now()) @map("created_at")
  channel    Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@map("share_links")
}

// ---------- Channels ----------

model Channel {
  id          String        @id @default(cuid())
  tgChatId    BigInt        @unique @map("tg_chat_id")
  title       String
  username    String? // public @username if any
  workspaceId String        @map("workspace_id")
  botStatus   BotStatus     @default(PENDING) @map("bot_status")
  /** Real channel size from getChatMemberCount; synced on connect and periodically. */
  memberCount   Int?      @map("member_count")
  memberCountAt DateTime? @map("member_count_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  links       TrackedLink[]
  subscribers Subscriber[]
  events      MemberEvent[]
  postbacks   Postback[]
  sales       SaleEvent[]
  apiKeys     ChannelApiKey[]
  alertSubs   AlertSubscription[]
  shareLinks  ShareLink[]
  integrations AdIntegration[]

  @@map("channels")
}

enum BotStatus {
  PENDING // channel created, bot not yet admin
  ACTIVE // bot is admin, receiving chat_member updates
  REMOVED // bot lost admin rights
}

// ---------- Attribution core ----------

model TrackedLink {
  id            String       @id @default(cuid())
  slug          String       @unique // go.<domain>/l/<slug>
  channelId     String       @map("channel_id")
  label         String // human name: "посев @channel 18.08"
  creative      String? // creative tag
  /** Media buyer or contractor who owns this placement; enables buyer comparison. */
  buyer         String?
  utmSource     String?      @map("utm_source")
  utmMedium     String?      @map("utm_medium")
  utmCampaign   String?      @map("utm_campaign")
  targetPostUrl String?      @map("target_post_url") // landing-post mode: redirect to a post instead of invite
  inviteLink    String?      @map("invite_link") // unique t.me/+... created via Bot API
  isRevoked     Boolean      @default(false) @map("is_revoked")
  createdAt     DateTime     @default(now()) @map("created_at")
  channel       Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  clicks        Click[]
  subscribers   Subscriber[]
  events        MemberEvent[]
  pixelEvents   PixelEvent[]

  @@index([channelId])
  @@map("tracked_links")
}

model Click {
  id        String      @id @default(cuid())
  linkId    String      @map("link_id")
  ts        DateTime    @default(now())
  ipHash    String?     @map("ip_hash") // sha256, privacy-preserving
  uaHash    String?     @map("ua_hash")
  referer   String?
  /** Pixel visitor id (localStorage cid) when the click came from a pixeled landing */
  clientId  String?     @map("client_id")
  /** Ad-platform click ids captured on the landing: { yclid?, gclid?, fbclid?, ttclid? } */
  adClickIds Json?      @map("ad_click_ids")
  landingUrl String?    @map("landing_url")
  link      TrackedLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, ts])
  @@index([linkId, clientId])
  @@map("clicks")
}

/** Raw pixel telemetry from landing pages (pageviews and outbound clicks). */
model PixelEvent {
  id        String         @id @default(cuid())
  linkId    String         @map("link_id")
  clientId  String         @map("client_id")
  type      PixelEventType
  url       String?
  referer   String?
  utmSource String?        @map("utm_source")
  utmMedium String?        @map("utm_medium")
  utmCampaign String?      @map("utm_campaign")
  adClickIds Json?         @map("ad_click_ids")
  ts        DateTime       @default(now())
  link      TrackedLink    @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, ts])
  @@index([linkId, clientId])
  @@map("pixel_events")
}

enum PixelEventType {
  PAGEVIEW
  CLICK
}

/**
 * Native ad-platform connection. Credentials are stored encrypted (AES-256-GCM);
 * `config` holds non-secret settings such as pixel id, counter id or goal name.
 */
model AdIntegration {
  id           String             @id @default(cuid())
  channelId    String             @map("channel_id")
  provider     AdProvider
  isActive     Boolean            @default(true) @map("is_active")
  credentials  String // encrypted JSON blob, never returned by the API
  config       Json
  /** Send joins, and optionally leaves as a negative signal where supported. */
  sendJoins    Boolean            @default(true) @map("send_joins")
  lastSyncAt   DateTime?          @map("last_sync_at")
  lastStatus   String?            @map("last_status")
  lastError    String?            @map("last_error")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  channel      Channel            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  uploads      ConversionUpload[]

  @@unique([channelId, provider])
  @@map("ad_integrations")
}

enum AdProvider {
  META_CAPI
  YANDEX_METRIKA
  GOOGLE_ADS
  TIKTOK_EVENTS
}

/**
 * Outbox for conversions owed to an ad platform. Written synchronously with the
 * join event, delivered by a worker, so a platform outage never loses a conversion.
 */
model ConversionUpload {
  id            String           @id @default(cuid())
  integrationId String           @map("integration_id")
  /** Stable dedup key shared with the platform (event_id / PurchaseID). */
  eventKey      String           @map("event_key")
  clickId       String?          @map("click_id")
  occurredAt    DateTime         @map("occurred_at")
  status        UploadStatus     @default(PENDING)
  attempts      Int              @default(0)
  lastError     String?          @map("last_error")
  sentAt        DateTime?        @map("sent_at")
  payload       Json
  createdAt     DateTime         @default(now()) @map("created_at")
  integration   AdIntegration    @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, eventKey])
  @@index([status, createdAt])
  @@map("conversion_uploads")
}

enum UploadStatus {
  PENDING
  SENT
  FAILED
}

/** Server-to-server conversion postback template, fired on attributed joins. */
model Postback {
  id          String   @id @default(cuid())
  channelId   String   @map("channel_id")
  name        String
  /** URL template with macros: {event} {slug} {label} {cid} {yclid} {gclid} {fbclid} {ttclid} */
  urlTemplate String   @map("url_template")
  onJoin      Boolean  @default(true) @map("on_join")
  onLeave     Boolean  @default(false) @map("on_leave")
  isActive    Boolean  @default(true) @map("is_active")
  /** Last delivery outcome, so failures are visible without digging through logs. */
  lastStatus  Int?      @map("last_status") // HTTP status, null when the request never completed
  lastError   String?   @map("last_error")
  lastFiredAt DateTime? @map("last_fired_at")
  createdAt   DateTime @default(now()) @map("created_at")
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@map("postbacks")
}

/** Revenue events uploaded or pushed by webhook: closes the loop from source to money. */
model SaleEvent {
  id          String    @id @default(cuid())
  channelId   String    @map("channel_id")
  /** Buyer identity as provided: Telegram id preferred, username as fallback. */
  tgUserId    BigInt?   @map("tg_user_id")
  username    String?
  amount      Decimal   @db.Decimal(12, 2)
  currency    String    @default("USD")
  kind        SaleKind  @default(PURCHASE)
  externalId  String?   @map("external_id")
  occurredAt  DateTime  @map("occurred_at")
  /** Resolved at ingest time from the subscriber's attribution. */
  linkId      String?   @map("link_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  channel     Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, externalId])
  @@index([channelId, occurredAt])
  @@index([linkId])
  @@map("sale_events")
}

enum SaleKind {
  LEAD
  PURCHASE
  REFUND
}

/** Per-channel ingest key for the sales webhook (rotatable, never reused). */
model ChannelApiKey {
  id        String    @id @default(cuid())
  channelId String    @map("channel_id")
  keyHash   String    @unique @map("key_hash") // sha256 of the raw key
  prefix    String // first chars, shown in UI for identification
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")
  channel   Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@map("channel_api_keys")
}

/** Instant join/leave alert opt-in, persisted across bot restarts. */
model AlertSubscription {
  channelId String   @map("channel_id")
  tgUserId  BigInt   @map("tg_user_id")
  createdAt DateTime @default(now()) @map("created_at")
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([channelId, tgUserId])
  @@map("alert_subscriptions")
}

model Subscriber {
  id           String       @id @default(cuid())
  channelId    String       @map("channel_id")
  tgUserId     BigInt       @map("tg_user_id")
  username     String?
  firstName    String?      @map("first_name")
  isPremium    Boolean      @default(false) @map("is_premium")
  linkId       String?      @map("link_id") // attribution: which tracked link brought them
  attribution  Attribution  @default(UNKNOWN) // how confident the attribution is
  joinedAt     DateTime     @map("joined_at")
  leftAt       DateTime?    @map("left_at")
  rejoinCount  Int          @default(0) @map("rejoin_count")
  channel      Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  link         TrackedLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)

  @@unique([channelId, tgUserId])
  @@index([channelId, joinedAt])
  @@index([linkId])
  @@map("subscribers")
}

enum Attribution {
  EXACT // joined via our unique invite link
  PROBABLE // time-window click matching (landing-post mode)
  ORGANIC // native TG invite link / search / forward
  UNKNOWN
}

// Raw event log: source of truth for all analytics
model MemberEvent {
  id        String       @id @default(cuid())
  channelId String       @map("channel_id")
  tgUserId  BigInt       @map("tg_user_id")
  type      EventType
  linkId    String?      @map("link_id")
  ts        DateTime     @default(now())
  channel   Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  link      TrackedLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)

  @@index([channelId, ts])
  @@map("member_events")
}

enum EventType {
  JOIN
  LEAVE
}

