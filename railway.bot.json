{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build:bot"
  },
  "deploy": {
    "startCommand": "npm run db:push -w packages/db && npm run start -w apps/bot",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
