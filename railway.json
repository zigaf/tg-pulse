{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build:web"
  },
  "deploy": {
    "startCommand": "npm run db:push -w packages/db && npm run start -w apps/web",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE"
  }
}
