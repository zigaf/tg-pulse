# --- shared ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tgpulse
# Ad-platform credential encryption, read by both web and bot. 32 random bytes, hex:
#   openssl rand -hex 32
# Rotating it invalidates every stored credential by design; users reconnect.
ENCRYPTION_KEY=

# --- apps/bot ---
BOT_TOKEN=            # from @BotFather
PUBLIC_URL=           # e.g. https://tgpulse-bot.up.railway.app (prod only)
WEBHOOK_SECRET=       # random string; empty = long polling (dev)
PORT=8080
# Telegram user ids allowed to run /admin commands, comma-separated. Empty = disabled.
ADMIN_TG_IDS=

# --- monitoring (optional; empty = Sentry disabled) ---
SENTRY_DSN=                 # server-side DSN, read by bot and web
NEXT_PUBLIC_SENTRY_DSN=     # browser DSN for the web app (may equal SENTRY_DSN)
